<Window x:Class="MairsTrivia.Editor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mair's Trivia Question Set Editor" Width="1200" Height="760" Background="#101010" Foreground="#F7F3F5" Closing="OnClosing">
  <DockPanel Margin="14">
    <ToolBar DockPanel.Dock="Top">
      <Button Click="New_Click">New</Button><Button Click="Open_Click">Open</Button><Button Click="Save_Click">Save</Button><Button Click="SaveAs_Click">Save As</Button><Separator/>
      <Button Click="Import_Click">Import</Button><Button Click="Export_Click">Export</Button><Button Click="Validate_Click">Validate</Button><Button Click="UpgradeSchema_Click">Upgrade to Schema v2</Button>
    </ToolBar>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,8,12,0">
        <TextBlock Text="QUESTION SET" FontWeight="Bold" Foreground="#FF2BD6"/>
        <TextBox x:Name="TitleBox" ToolTip="Title" TextChanged="Dirty"/><TextBox x:Name="AuthorBox" ToolTip="Author" TextChanged="Dirty"/><TextBox x:Name="VersionBox" ToolTip="Version" TextChanged="Dirty"/><TextBox x:Name="CategoriesBox" ToolTip="Categories (comma separated)" TextChanged="Dirty"/><TextBox x:Name="TagsBox" ToolTip="Tags (comma separated)" TextChanged="Dirty"/><TextBox x:Name="DescriptionBox" ToolTip="Description" Height="80" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Dirty"/>
        <Separator/><TextBox x:Name="SearchBox" ToolTip="Search questions and answers" TextChanged="FilterChanged"/><TextBox x:Name="CategoryFilterBox" ToolTip="Filter category" TextChanged="FilterChanged"/><TextBox x:Name="TagFilterBox" ToolTip="Filter tag" TextChanged="FilterChanged"/>
        <ListBox x:Name="QuestionList" Height="340" DisplayMemberPath="Question" SelectionChanged="QuestionSelected"/>
        <WrapPanel><Button Click="Add_Click">Add</Button><Button Click="Edit_Click">Edit</Button><Button Click="Duplicate_Click">Duplicate</Button><Button Click="Delete_Click">Delete</Button><Button Click="Up_Click">Up</Button><Button Click="Down_Click">Down</Button></WrapPanel>
      </StackPanel>
      <Grid Grid.Column="1" Margin="8,8,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="QUESTION EDITOR" FontWeight="Bold" Foreground="#FF2BD6"/>
        <StackPanel Grid.Row="1">
          <TextBox x:Name="QuestionBox" ToolTip="Question text" TextChanged="Dirty"/><TextBox x:Name="CorrectBox" ToolTip="Correct answer" TextChanged="Dirty"/>
          <TextBlock x:Name="IncorrectAnswersStatus" Text="INCORRECT ANSWERS — 3–9 required" Margin="3,8" FontWeight="Bold"/>
          <WrapPanel><Button Click="AddIncorrect_Click">Add incorrect answer</Button><Button Click="RemoveIncorrect_Click">Remove last</Button></WrapPanel>
          <StackPanel x:Name="IncorrectAnswers"/>
          <TextBox x:Name="QuestionCategoryBox" ToolTip="Question category" TextChanged="Dirty"/><TextBox x:Name="QuestionTagsBox" ToolTip="Question tags (comma separated)" TextChanged="Dirty"/>
        </StackPanel>
        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#FF2BD6" Text="Ready."/>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
